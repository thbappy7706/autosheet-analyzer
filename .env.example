# Copy to .env and adjust as needed. The backend reads these directly from the
# process environment, so export them (or use your shell's env loader) before
# running `go run ./cmd/server`.

# --- Backend ---------------------------------------------------------------
# Address the HTTP server listens on.
ADDR=:8080

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=50

# Allowed frontend origin for CORS.
CORS_ORIGIN=http://localhost:5173

# How long parsed uploads stay in memory / on disk before being evicted.
STORE_TTL_MINUTES=60

# Rows profiled before falling back to a sample. 0 disables sampling.
SAMPLE_ROWS=200000

# Directory for temporary uploaded files (defaults to the OS temp dir).
# TEMP_DIR=

# Per-IP requests per minute. 0 disables rate limiting.
RATE_LIMIT_PER_MIN=120

# --- Frontend --------------------------------------------------------------
# Base path of the API. Defaults to /api/v1 (proxied by Vite in dev).
# VITE_API_BASE=/api/v1

# Must match MAX_UPLOAD_MB so the client can reject oversized files early.
VITE_MAX_UPLOAD_MB=50
