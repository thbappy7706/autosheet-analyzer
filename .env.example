# Backend configuration.
#
# Copy this file to `.env` in this directory and the Go server will load it
# automatically at startup:
#
#     cp .env.example .env
#
# Values you export in your shell always take precedence over the file, so you
# can override a single setting for one run:
#
#     MAX_UPLOAD_MB=200 make dev-backend
#
# Point the server at a different file with ENV_FILE=/path/to/file.
# (The frontend reads its own settings from frontend/.env — see
# frontend/.env.example.)

# --- Backend ---------------------------------------------------------------

# Address the HTTP server listens on.
ADDR=:8080

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=50

# Allowed frontend origin for CORS.
CORS_ORIGIN=http://localhost:5173

# How long parsed uploads stay in memory / on disk before being evicted.
STORE_TTL_MINUTES=60

# Rows profiled before falling back to a sample. 0 disables sampling.
SAMPLE_ROWS=200000

# Directory for temporary uploaded files (defaults to the OS temp dir).
# TEMP_DIR=

# Per-IP requests per minute. 0 disables rate limiting.
RATE_LIMIT_PER_MIN=120
