# Copy to frontend/.env — Vite loads this automatically (it does NOT read the
# repository-root .env file).

# Base path of the API. The default works with the Vite dev proxy.
# VITE_API_BASE=/api/v1

# Must match the backend's MAX_UPLOAD_MB so the client rejects oversized files
# early, before the upload starts.
VITE_MAX_UPLOAD_MB=50
